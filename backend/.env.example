# Application
ENVIRONMENT=development
API_PREFIX=/api
SECRET_KEY=replace-with-a-long-random-value-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Atlas (optional locally; the API uses an in-memory development store when omitted)
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=mediassist

# Gemini — Dr. Homie agent (required for AI chat, voice, and image analysis)
# Same key style as Dr. Homie; get one from Google AI Studio if needed.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=models/gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Integrations and limits
OVERPASS_URL=https://overpass-api.de/api/interpreter
MAX_UPLOAD_SIZE_BYTES=10485760
HOSPITAL_CACHE_TTL_SECONDS=300

# Outbound-call resilience. Each Gemini request is bounded by
# GEMINI_REQUEST_TIMEOUT_SECONDS and the whole model-failover loop by
# GEMINI_OVERALL_TIMEOUT_SECONDS; only transient errors (408/425/429/5xx) are
# retried, up to GEMINI_MAX_RETRIES times. Overpass lookups use a short timeout
# plus a circuit-breaker cooldown so a failing map endpoint degrades gracefully.
GEMINI_REQUEST_TIMEOUT_SECONDS=45
GEMINI_OVERALL_TIMEOUT_SECONDS=110
GEMINI_MAX_RETRIES=2
OVERPASS_TIMEOUT_SECONDS=12
OVERPASS_CIRCUIT_COOLDOWN_SECONDS=60

# Expose an aggregate, PHI-free /metrics counter snapshot for operators.
# Set false to hide the endpoint in shared environments.
ENABLE_METRICS=true

# Rate-limit identity: only set true when running behind a trusted reverse proxy
# that overwrites X-Forwarded-For (otherwise clients could spoof it to evade limits).
TRUST_PROXY=false

# Upper bound on turns retained per conversation (older turns are trimmed).
MAX_CONVERSATION_MESSAGES=400

# Lifetime of a signed, account-free report share link (minutes).
REPORT_SHARE_EXPIRE_MINUTES=10080

# Session cookie (httpOnly). The frontend relies on this instead of reading the
# token in JavaScript. Secure is forced on automatically when ENVIRONMENT=production.
# Set SAMESITE=none (and a real HTTPS deployment) only for cross-site frontends.
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
