      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{\n  --canvas:#F3F7FA; --surface:#FFFFFF; --surface-alt:#EAF3F8;\n  --ink:#172B3A; --ink-2:#4B606D; --ink-3:#6C7F89; --rule:#CEDCE4;\n  --brand:#126B9A; --brand-strong:#0E567B; --brand-tint:#E7F1F7;\n  --low:#237B69; --low-bg:#E7F4EF;\n  --med:#956018; --med-bg:#FBF1DC;\n  --high:#AB502B; --high-bg:#FBE9DE;\n  --emg:#AE3446; --emg-bg:#FBE6E9;\n}\n.font-ui{font-family:'Manrope',system-ui,sans-serif;}\n.font-read{font-family:'Atkinson Hyperlegible',system-ui,sans-serif;}\n.tnum{font-variant-numeric:tabular-nums;}\n.lucide{stroke-width:1.75;}\n</style>\n<div class=\"font-read flex min-h-screen bg-[var(--canvas)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\" style=\"line-height:1.55\">\n    <!-- ============ SIDEBAR ============ -->\n    <aside class=\"sticky top-0 h-screen w-[264px] shrink-0 overflow-y-auto border-r border-[var(--rule)] bg-[var(--surface)]\" data-kid=\"1-1\" data-name=\"settings sidebar aside\">\n        <div class=\"flex h-16 items-center gap-2.5 px-5\" data-kid=\"1-1-1\" data-name=\"sidebar brand header row\">\n            <div class=\"grid h-9 w-9 place-items-center rounded-lg bg-[var(--brand-tint)]\" data-kid=\"1-1-1-1\" data-name=\"brand logo icon container\">\n                <i class=\"lucide icon-heart-pulse text-[18px] text-[var(--brand)]\" data-kid=\"1-1-1-1-1\" data-name=\"heart pulse logo icon\">\n                </i>\n            </div>\n            <div class=\"font-ui text-[17px] font-extrabold tracking-tight\" data-kid=\"1-1-1-2\" data-name=\"brand wordmark text\">\n                <span class=\"text-[var(--ink)]\" data-kid=\"1-1-1-2-1\" data-name=\"brand wordmark Medi segment\">\n                    Medi\n                </span>\n                <span class=\"text-[var(--brand)]\" data-kid=\"1-1-1-2-2\" data-name=\"brand wordmark Assist segment in brand color\">\n                    Assist\n                </span>\n                <span class=\"font-bold text-[var(--ink-3)]\" data-kid=\"1-1-1-2-3\" data-name=\"brand wordmark AI suffix segment\">\n                    AI\n                </span>\n            </div>\n        </div>\n        <nav class=\"px-3 py-2\" data-kid=\"1-1-2\" data-name=\"main sidebar navigation\">\n            <div class=\"px-2 pb-1.5 pt-2 font-ui text-[11px] font-bold uppercase tracking-[0.09em] text-[var(--ink-3)]\" data-kid=\"1-1-2-1\" data-name=\"navigation section label Care\">\n                Care\n            </div>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-2\" data-name=\"nav link Overview with house icon\" href=\"#\">\n                <i class=\"lucide icon-house text-[18px]\" data-kid=\"1-1-2-2-1\" data-name=\"house icon\">\n                </i>\n                Overview\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-3\" data-name=\"nav link AI consultation with chat icon\" href=\"#\">\n                <i class=\"lucide icon-messages-square text-[18px]\" data-kid=\"1-1-2-3-1\" data-name=\"messages chat icon\">\n                </i>\n                AI consultation\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-4\" data-name=\"nav link Voice consultation with mic icon\" href=\"#\">\n                <i class=\"lucide icon-mic text-[18px]\" data-kid=\"1-1-2-4-1\" data-name=\"microphone icon\">\n                </i>\n                Voice consultation\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-5\" data-name=\"nav link Image analysis with image icon\" href=\"#\">\n                <i class=\"lucide icon-image text-[18px]\" data-kid=\"1-1-2-5-1\" data-name=\"image icon\">\n                </i>\n                Image analysis\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-6\" data-name=\"nav link Nearby care with map pin icon\" href=\"#\">\n                <i class=\"lucide icon-map-pin text-[18px]\" data-kid=\"1-1-2-6-1\" data-name=\"map pin icon\">\n                </i>\n                Nearby care\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-7\" data-name=\"nav link Health check-in with shield check icon\" href=\"#\">\n                <i class=\"lucide icon-shield-check text-[18px]\" data-kid=\"1-1-2-7-1\" data-name=\"shield check icon\">\n                </i>\n                Health check-in\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-8\" data-name=\"nav link Reminders with bell icon\" href=\"#\">\n                <i class=\"lucide icon-bell text-[18px]\" data-kid=\"1-1-2-8-1\" data-name=\"bell icon\">\n                </i>\n                Reminders\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-9\" data-name=\"nav link Reports with document icon\" href=\"#\">\n                <i class=\"lucide icon-file-text text-[18px]\" data-kid=\"1-1-2-9-1\" data-name=\"document text icon\">\n                </i>\n                Reports\n            </a>\n            <div class=\"my-3 border-t border-[var(--rule)]\" data-kid=\"1-1-2-10\" data-name=\"navigation divider line\">\n            </div>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-11\" data-name=\"nav link Profile with user icon\" href=\"#\">\n                <i class=\"lucide icon-user text-[18px]\" data-kid=\"1-1-2-11-1\" data-name=\"user icon\">\n                </i>\n                Profile\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg bg-[var(--brand-tint)] px-3 py-2.5 font-ui text-[14.5px] font-semibold text-[var(--brand)]\" data-kid=\"1-1-2-12\" data-name=\"nav link Settings active with settings icon\" href=\"#\">\n                <i class=\"lucide icon-settings text-[18px]\" data-kid=\"1-1-2-12-1\" data-name=\"settings gear icon\">\n                </i>\n                Settings\n            </a>\n        </nav>\n        <div class=\"mt-2 px-3 pb-4\" data-kid=\"1-1-3\" data-name=\"sidebar bottom action area\">\n            <div class=\"rounded-xl bg-[var(--surface-alt)] p-4\" data-kid=\"1-1-3-1\" data-name=\"find nearby care callout card\">\n                <div class=\"flex items-center gap-2 font-ui text-[13.5px] font-bold text-[var(--ink)]\" data-kid=\"1-1-3-1-1\" data-name=\"callout card title row\">\n                    <i class=\"lucide icon-map-pin text-[16px] text-[var(--brand)]\" data-kid=\"1-1-3-1-1-1\" data-name=\"map pin icon\">\n                    </i>\n                    Need care soon?\n                </div>\n                <p class=\"mt-1 text-[13px] leading-snug text-[var(--ink-2)]\" data-kid=\"1-1-3-1-2\" data-name=\"callout card description text\">\n                    Find nearby hospitals and emergency rooms.\n                </p>\n                <a class=\"mt-2 inline-flex items-center gap-1 font-ui text-[13px] font-semibold text-[var(--brand)] hover:text-[var(--brand-strong)]\" data-kid=\"1-1-3-1-3\" data-name=\"find care action link\" href=\"#\">\n                    Find care\n                    <i class=\"lucide icon-arrow-right text-[14px]\" data-kid=\"1-1-3-1-3-1\" data-name=\"right arrow icon\">\n                    </i>\n                </a>\n            </div>\n            <a class=\"mt-3 flex items-center gap-2.5 rounded-lg px-3 py-2 font-ui text-[13.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--emg-bg)] hover:text-[var(--emg)]\" data-kid=\"1-1-3-2\" data-name=\"sign out link in sidebar\" href=\"#\">\n                <i class=\"lucide icon-log-out text-[17px]\" data-kid=\"1-1-3-2-1\" data-name=\"log out icon\">\n                </i>\n                Sign out\n            </a>\n        </div>\n    </aside>\n    <!-- ============ MAIN ============ -->\n    <div class=\"flex min-w-0 flex-1 flex-col\" data-kid=\"1-2\" data-name=\"main content column\">\n        <header class=\"sticky top-0 z-20 flex h-16 items-center justify-between border-b border-[var(--rule)] bg-[var(--surface)] px-6 lg:px-8\" data-kid=\"1-2-1\" data-name=\"top header bar\">\n            <h1 class=\"font-ui text-[19px] font-bold tracking-tight text-[var(--ink)]\" data-kid=\"1-2-1-1\" data-name=\"page title Settings heading\">\n                Settings\n            </h1>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2\" data-name=\"header right actions group\">\n                <button aria-label=\"Switch to dark mode\" class=\"grid h-10 w-10 place-items-center rounded-lg border border-[var(--rule)] bg-[var(--surface)] text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-2-1\" data-name=\"dark mode toggle button\">\n                    <i class=\"lucide icon-moon text-[18px]\" data-kid=\"1-2-1-2-1-1\" data-name=\"moon icon\">\n                    </i>\n                </button>\n                <a class=\"flex items-center gap-2.5 rounded-lg py-1 pl-1 pr-3 transition-colors hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-1-2-2\" data-name=\"user account dropdown trigger\" href=\"#\">\n                    <span class=\"grid h-8 w-8 place-items-center rounded-full bg-[var(--brand)] font-ui text-[12.5px] font-bold text-white\" data-kid=\"1-2-1-2-2-1\" data-name=\"user avatar initials badge\">\n                        DU\n                    </span>\n                    <span class=\"font-ui text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-1-2-2-2\" data-name=\"user display name text\">\n                        Demo User\n                    </span>\n                </a>\n            </div>\n        </header>\n        <main class=\"mx-auto w-full max-w-[820px] px-6 py-8 lg:px-8\" data-kid=\"1-2-2\" data-name=\"main settings content\">\n            <!-- 1) Appearance -->\n            <section class=\"rounded-2xl border border-[var(--rule)] bg-[var(--surface)] p-6 shadow-[0_1px_2px_rgba(15,37,49,.06)]\" data-kid=\"1-2-2-1\" data-name=\"appearance settings card\">\n                <h2 class=\"font-ui text-[16px] font-bold tracking-tight text-[var(--ink)]\" data-kid=\"1-2-2-1-1\" data-name=\"appearance section heading\">\n                    Appearance\n                </h2>\n                <p class=\"mt-1 text-[14px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-2\" data-name=\"appearance section description\">\n                    Choose how MediAssist looks on this device.\n                </p>\n                <div aria-label=\"Theme\" class=\"mt-4 inline-flex w-full max-w-[300px] gap-1 rounded-lg bg-[var(--surface-alt)] p-1\" data-kid=\"1-2-2-1-3\" data-name=\"theme toggle segmented control\" role=\"group\">\n                    <button aria-pressed=\"true\" class=\"flex flex-1 items-center justify-center gap-2 rounded-md bg-[var(--brand-tint)] px-4 py-2 font-ui text-[14px] font-semibold text-[var(--brand)] shadow-[0_1px_2px_rgba(15,37,49,.08)]\" data-kid=\"1-2-2-1-3-1\" data-name=\"theme option Light button\">\n                        <i class=\"lucide icon-sun text-[16px]\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"sun icon\">\n                        </i>\n                        Light\n                    </button>\n                    <button aria-pressed=\"false\" class=\"flex flex-1 items-center justify-center gap-2 rounded-md px-4 py-2 font-ui text-[14px] font-medium text-[var(--ink-2)] transition-colors hover:text-[var(--ink)]\" data-kid=\"1-2-2-1-3-2\" data-name=\"theme option Dark button\">\n                        <i class=\"lucide icon-moon text-[16px]\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"moon icon\">\n                        </i>\n                        Dark\n                    </button>\n                </div>\n                <p class=\"mt-3 text-[13px] text-[var(--ink-3)]\" data-kid=\"1-2-2-1-4\" data-name=\"theme saved note text\">\n                    Your theme is saved on this device.\n                </p>\n            </section>\n            <!-- 2) Session -->\n            <section class=\"mt-6 rounded-2xl border border-[var(--rule)] bg-[var(--surface)] p-6 shadow-[0_1px_2px_rgba(15,37,49,.06)]\" data-kid=\"1-2-2-2\" data-name=\"session settings card\">\n                <h2 class=\"font-ui text-[16px] font-bold tracking-tight text-[var(--ink)]\" data-kid=\"1-2-2-2-1\" data-name=\"session section heading\">\n                    Session\n                </h2>\n                <div class=\"mt-4 flex items-center gap-3\" data-kid=\"1-2-2-2-2\" data-name=\"signed-in user info row\">\n                    <span class=\"grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[var(--brand)] font-ui text-[15px] font-bold text-white\" data-kid=\"1-2-2-2-2-1\" data-name=\"user avatar initials badge\">\n                        DU\n                    </span>\n                    <div class=\"min-w-0\" data-kid=\"1-2-2-2-2-2\" data-name=\"user info text block\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"signed-in email row\">\n                            <p class=\"font-ui text-[15px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"signed-in email text\">\n                                Signed in as demo.user@example.com\n                            </p>\n                            <span class=\"rounded-full bg-[var(--surface-alt)] px-2 py-0.5 font-ui text-[11.5px] font-bold text-[var(--ink-2)]\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"you badge pill\">\n                                you\n                            </span>\n                        </div>\n                        <p class=\"mt-0.5 text-[14px] text-[var(--ink-2)]\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"session persistence note\">\n                            You stay signed in on this device until you sign out.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-5 flex items-center gap-3 border-t border-[var(--rule)] pt-5\" data-kid=\"1-2-2-2-3\" data-name=\"sign out action row\">\n                    <button class=\"inline-flex h-11 items-center gap-2 rounded-lg border border-[var(--emg)]/40 bg-[var(--surface)] px-4 font-ui text-[14px] font-semibold text-[var(--emg)] transition-colors hover:bg-[var(--emg-bg)]\" data-kid=\"1-2-2-2-3-1\" data-name=\"sign out button\">\n                        <i class=\"lucide icon-log-out text-[17px]\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"log out icon\">\n                        </i>\n                        Sign out\n                    </button>\n                    <p class=\"text-[13px] text-[var(--ink-3)]\" data-kid=\"1-2-2-2-3-2\" data-name=\"sign out consequence note\">\n                        Signing out ends your session on this device.\n                    </p>\n                </div>\n            </section>\n            <!-- 3) Safety -->\n            <section class=\"mt-6 rounded-2xl border border-[var(--rule)] bg-[var(--surface)] p-6 shadow-[0_1px_2px_rgba(15,37,49,.06)]\" data-kid=\"1-2-2-3\" data-name=\"safety settings card\">\n                <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-2-3-1\" data-name=\"safety section header with icon\">\n                    <i class=\"lucide icon-shield-check text-[20px] text-[var(--brand)]\" data-kid=\"1-2-2-3-1-1\" data-name=\"shield check icon\">\n                    </i>\n                    <h2 class=\"font-ui text-[16px] font-bold tracking-tight text-[var(--ink)]\" data-kid=\"1-2-2-3-1-2\" data-name=\"safety section heading\">\n                        Safety\n                    </h2>\n                </div>\n                <div class=\"mt-4 space-y-3 text-[14.5px] leading-relaxed text-[var(--ink-2)]\" data-kid=\"1-2-2-3-2\" data-name=\"safety disclaimer text block\">\n                    <p data-kid=\"1-2-2-3-2-1\" data-name=\"educational information disclaimer\">\n                        MediAssist AI provides educational information only and never confirms a medical diagnosis.\n                    </p>\n                    <p data-kid=\"1-2-2-3-2-2\" data-name=\"emergency guidance paragraph\">\n                        For emergencies — chest pain, difficulty breathing, stroke symptoms, severe bleeding, loss of consciousness, or thoughts of self-harm — call your local emergency services immediately.\n                    </p>\n                </div>\n            </section>\n            <p class=\"mt-8 flex items-center justify-center gap-2 text-center text-[12.5px] text-[var(--ink-3)]\" data-kid=\"1-2-2-4\" data-name=\"footer educational disclaimer row\">\n                <i class=\"lucide icon-shield-check text-[14px]\" data-kid=\"1-2-2-4-1\" data-name=\"shield check icon\">\n                </i>\n                MediAssist provides educational information only — not a medical diagnosis, treatment plan, or emergency service.\n            </p>\n        </main>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-18T11:50:59.247902+00:00",
      "modified": "2026-10-18T11:51:32.084453+00:00",
      "id": "var_139bddc0db77",
      "contentHeight": 1000
    },
    "var_fcb5dabef1b6": {
      "type": "variant",
      "label": "Nearby care — revamp",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 12320,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.app{\n  --canvas:#F3F7FA; --surface:#FFFFFF; --surface-alt:#EAF3F8;\n  --ink:#172B3A; --ink-2:#4B606D; --rule:#CEDCE4;\n  --brand:#126B9A; --brand-strong:#0E567B; --brand-tint:#E7F1F7;\n  --low:#237B69; --low-bg:#E7F4EF; --med:#956018; --med-bg:#FBF1DC;\n  --high:#AB502B; --high-bg:#FBE9DE; --emg:#AE3446; --emg-bg:#FBE6E9;\n  font-family:'Manrope',system-ui,sans-serif; color:var(--ink); background:var(--canvas);\n}\n.read{font-family:'Atkinson Hyperlegible',system-ui,sans-serif;}\n.tabnum{font-variant-numeric:tabular-nums;}\ni[class*=\"icon-\"]{font-style:normal;line-height:1;display:inline-flex;align-items:center;}\n.mapgrid{\n  background-color:#E9F1EC;\n  background-image:\n    linear-gradient(0deg, rgba(180,200,190,.35) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(180,200,190,.35) 1px, transparent 1px);\n  background-size:34px 34px;\n}\n</style>\n<div class=\"app min-h-screen w-full\" data-kid=\"1\">\n    <!-- SIDEBAR -->\n    <aside class=\"fixed inset-y-0 left-0 z-40 hidden w-[264px] flex-col border-r border-[var(--rule)] bg-[var(--surface)] px-4 py-5 lg:flex\" data-kid=\"1-1\">\n        <a class=\"flex items-center gap-2.5 px-1\" data-kid=\"1-1-1\" href=\"#\">\n            <span class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--brand-tint)] text-[var(--brand)]\" data-kid=\"1-1-1-1\">\n                <i class=\"icon-heart-pulse text-[19px]\" data-kid=\"1-1-1-1-1\">\n                </i>\n            </span>\n            <span class=\"text-[16px] font-extrabold tracking-tight\" data-kid=\"1-1-1-2\">\n                Medi\n                <span class=\"text-[var(--brand)]\" data-kid=\"1-1-1-2-1\">\n                    Assist\n                </span>\n                <span class=\"font-semibold text-[var(--ink-2)]\" data-kid=\"1-1-1-2-2\">\n                    AI\n                </span>\n            </span>\n        </a>\n        <p class=\"mt-8 mb-2 px-3 text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--ink-2)]\" data-kid=\"1-1-2\">\n            Care\n        </p>\n        <nav class=\"flex flex-col gap-1\" data-kid=\"1-1-3\">\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-1-3-1\" href=\"#\">\n                <i class=\"icon-home text-[18px]\" data-kid=\"1-1-3-1-1\">\n                </i>\n                Overview\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-1-3-2\" href=\"#\">\n                <i class=\"icon-message-square text-[18px]\" data-kid=\"1-1-3-2-1\">\n                </i>\n                AI consultation\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-1-3-3\" href=\"#\">\n                <i class=\"icon-mic text-[18px]\" data-kid=\"1-1-3-3-1\">\n                </i>\n                Voice consultation\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-1-3-4\" href=\"#\">\n                <i class=\"icon-image text-[18px]\" data-kid=\"1-1-3-4-1\">\n                </i>\n                Image analysis\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg bg-[var(--brand-tint)] px-3 py-2.5 text-[14px] font-bold text-[var(--brand)]\" data-kid=\"1-1-3-5\" href=\"#\">\n                <i class=\"icon-map-pin text-[18px]\" data-kid=\"1-1-3-5-1\">\n                </i>\n                Nearby care\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-1-3-6\" href=\"#\">\n                <i class=\"icon-shield-check text-[18px]\" data-kid=\"1-1-3-6-1\">\n                </i>\n                Health check-in\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-1-3-7\" href=\"#\">\n                <i class=\"icon-bell text-[18px]\" data-kid=\"1-1-3-7-1\">\n                </i>\n                Reminders\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-1-3-8\" href=\"#\">\n                <i class=\"icon-file-text text-[18px]\" data-kid=\"1-1-3-8-1\">\n                </i>\n                Reports\n            </a>\n        </nav>\n        <div class=\"my-3 border-t border-[var(--rule)]\" data-kid=\"1-1-4\">\n        </div>\n        <nav class=\"flex flex-col gap-1\" data-kid=\"1-1-5\">\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-1-5-1\" href=\"#\">\n                <i class=\"icon-user text-[18px]\" data-kid=\"1-1-5-1-1\">\n                </i>\n                Profile\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-1-5-2\" href=\"#\">\n                <i class=\"icon-settings text-[18px]\" data-kid=\"1-1-5-2-1\">\n                </i>\n                Settings\n            </a>\n        </nav>\n        <div class=\"mt-auto rounded-xl bg-[var(--surface-alt)] p-4\" data-kid=\"1-1-6\">\n            <div class=\"flex items-center gap-2 text-[13px] font-bold\" data-kid=\"1-1-6-1\">\n                <i class=\"icon-map-pin text-[16px] text-[var(--brand)]\" data-kid=\"1-1-6-1-1\">\n                </i>\n                Need care soon?\n            </div>\n            <p class=\"read mt-1 text-[12.5px] leading-[1.5] text-[var(--ink-2)]\" data-kid=\"1-1-6-2\">\n                Find nearby hospitals and emergency rooms.\n            </p>\n            <a class=\"mt-2 inline-flex items-center gap-1 text-[12.5px] font-bold text-[var(--brand)]\" data-kid=\"1-1-6-3\" href=\"#\">\n                Find care\n                <i class=\"icon-arrow-right text-[14px]\" data-kid=\"1-1-6-3-1\">\n                </i>\n            </a>\n        </div>\n        <button class=\"mt-3 flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-[var(--ink-2)] hover:bg-[var(--emg-bg)] hover:text-[var(--emg)]\" data-kid=\"1-1-7\">\n            <i class=\"icon-log-out text-[18px]\" data-kid=\"1-1-7-1\">\n            </i>\n            Sign out\n        </button>\n    </aside>\n    <!-- MAIN -->\n    <div class=\"lg:pl-[264px]\" data-kid=\"1-2\">\n        <!-- TOP HEADER -->\n        <header class=\"sticky top-0 z-30 flex h-16 items-center justify-between border-b border-[var(--rule)] bg-[var(--surface)] px-5 sm:px-8\" data-kid=\"1-2-1\">\n            <h1 class=\"text-[18px] font-bold tracking-tight\" data-kid=\"1-2-1-1\">\n                Nearby care\n            </h1>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-2-1-2\">\n                <button aria-label=\"Toggle dark mode\" class=\"flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--rule)] text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-1-2-1\">\n                    <i class=\"icon-sun text-[18px]\" data-kid=\"1-2-1-2-1-1\">\n                    </i>\n                </button>\n                <a class=\"flex items-center gap-2 rounded-lg py-1 pl-1 pr-3 hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-1-2-2\" href=\"#\">\n                    <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[var(--brand)] text-[12px] font-bold text-white\" data-kid=\"1-2-1-2-2-1\">\n                        DU\n                    </span>\n                    <span class=\"text-[14px] font-semibold\" data-kid=\"1-2-1-2-2-2\">\n                        Demo User\n                    </span>\n                </a>\n            </div>\n        </header>\n        <main class=\"mx-auto w-full max-w-[1200px] px-5 py-7 sm:px-8\" data-kid=\"1-2-2\">\n            <!-- PANEL -->\n            <section class=\"rounded-2xl border border-[var(--rule)] bg-[var(--surface)] shadow-[0_1px_2px_rgba(15,37,49,.06)]\" data-kid=\"1-2-2-1\">\n                <!-- panel header -->\n                <div class=\"flex flex-wrap items-start justify-between gap-4 border-b border-[var(--rule)] px-6 py-5\" data-kid=\"1-2-2-1-1\">\n                    <div data-kid=\"1-2-2-1-1-1\">\n                        <h2 class=\"text-[16px] font-bold tracking-tight\" data-kid=\"1-2-2-1-1-1-1\">\n                            Nearby hospitals & clinics\n                        </h2>\n                        <p class=\"read mt-1 text-[13px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-1-1-2\">\n                            Powered by OpenStreetMap / Overpass using your browser location.\n                        </p>\n                    </div>\n                    <button class=\"inline-flex h-11 items-center gap-2 rounded-lg border border-[var(--rule)] bg-[var(--surface)] px-4 text-[14px] font-semibold text-[var(--ink)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-2-1-1-2\">\n                        <i class=\"icon-refresh-cw text-[16px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-1-2-1\">\n                        </i>\n                        Refresh location\n                    </button>\n                </div>\n                <!-- SOURCE BANNER (fixes the fallback-vs-verified problem) -->\n                <div class=\"px-6 pt-5\" data-kid=\"1-2-2-1-2\">\n                    <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-2-2-1-2-1\">\n                        <span class=\"inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap text-[13.5px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"current location label\">\n                            <i class=\"icon-map-pin text-[15px] text-[var(--brand)]\" data-kid=\"1-2-2-1-2-1-1-1\">\n                            </i>\n                            Near Bandra West, Mumbai\n                        </span>\n                        <span class=\"h-4 w-px shrink-0 bg-[var(--rule)]\" data-kid=\"1-2-2-1-2-1-2\">\n                        </span>\n                        <span class=\"inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full bg-[var(--surface-alt)] px-2.5 py-1 text-[12px] font-semibold text-[var(--ink-2)]\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"data source badge\">\n                            <i class=\"icon-database text-[13px]\" data-kid=\"1-2-2-1-2-1-3-1\">\n                            </i>\n                            OpenStreetMap\n                        </span>\n                        <span class=\"inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full bg-[var(--med-bg)] px-2.5 py-1 text-[12px] font-bold text-[var(--med)]\" data-kid=\"1-2-2-1-2-1-4\" data-name=\"status badge\">\n                            <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--med)]\" data-kid=\"1-2-2-1-2-1-4-1\">\n                            </span>\n                            Offline · approximate\n                        </span>\n                    </div>\n                    <div class=\"mt-3 flex items-start gap-2.5 rounded-lg bg-[var(--med-bg)] px-4 py-3\" data-kid=\"1-2-2-1-2-2\" data-name=\"offline warning banner\">\n                        <i class=\"icon-triangle-alert mt-0.5 text-[16px] text-[var(--med)]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"warning triangle icon\">\n                        </i>\n                        <p class=\"read text-[13px] leading-[1.5] text-[#6b4708]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"offline warning message\">\n                            Showing\n                            <b data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"warning emphasized phrase\">\n                                approximate offline results — not verified\n                            </b>\n                            . These are stand-in facilities, not confirmed care near you. Refresh for live OpenStreetMap data.\n                        </p>\n                    </div>\n                </div>\n                <!-- MAP + LIST -->\n                <div class=\"grid grid-cols-1 gap-6 px-6 py-6 lg:grid-cols-[minmax(0,55fr)_minmax(0,45fr)]\" data-kid=\"1-2-2-1-3\">\n                    <!-- MAP -->\n                    <div class=\"relative h-[440px] overflow-hidden rounded-xl border border-[var(--rule)]\" data-kid=\"1-2-2-1-3-1\">\n                        <div class=\"mapgrid absolute inset-0\" data-kid=\"1-2-2-1-3-1-1\">\n                        </div>\n                        <!-- water -->\n                        <div class=\"absolute -left-10 bottom-0 h-[62%] w-[46%] rounded-[40%] bg-[#BFE0EA]\" data-kid=\"1-2-2-1-3-1-2\">\n                        </div>\n                        <!-- roads -->\n                        <div class=\"absolute left-0 top-[38%] h-[10px] w-full -rotate-3 bg-white/80\" data-kid=\"1-2-2-1-3-1-3\">\n                        </div>\n                        <div class=\"absolute left-[30%] top-0 h-full w-[9px] rotate-6 bg-white/70\" data-kid=\"1-2-2-1-3-1-4\">\n                        </div>\n                        <div class=\"absolute left-0 top-[70%] h-[6px] w-full rotate-2 bg-white/60\" data-kid=\"1-2-2-1-3-1-5\">\n                        </div>\n                        <div class=\"absolute left-[64%] top-0 h-full w-[6px] -rotate-3 bg-white/60\" data-kid=\"1-2-2-1-3-1-6\">\n                        </div>\n                        <!-- you-are-here -->\n                        <div class=\"absolute left-[46%] top-[52%] -translate-x-1/2 -translate-y-1/2\" data-kid=\"1-2-2-1-3-1-7\">\n                            <span class=\"absolute inset-0 -m-3 animate-none rounded-full bg-[var(--brand)]/15\" data-kid=\"1-2-2-1-3-1-7-1\">\n                            </span>\n                            <span class=\"relative block h-3.5 w-3.5 rounded-full border-2 border-white bg-[var(--brand)] shadow\" data-kid=\"1-2-2-1-3-1-7-2\">\n                            </span>\n                        </div>\n                        <!-- markers -->\n                        <div class=\"absolute left-[30%] top-[30%] flex flex-col items-center\" data-kid=\"1-2-2-1-3-1-8\">\n                            <i class=\"icon-map-pin text-[26px] text-[var(--high)] drop-shadow\" data-kid=\"1-2-2-1-3-1-8-1\">\n                            </i>\n                        </div>\n                        <div class=\"absolute left-[58%] top-[26%] flex flex-col items-center\" data-kid=\"1-2-2-1-3-1-9\">\n                            <i class=\"icon-map-pin text-[26px] text-[var(--brand)] drop-shadow\" data-kid=\"1-2-2-1-3-1-9-1\">\n                            </i>\n                        </div>\n                        <div class=\"absolute left-[68%] top-[58%] flex flex-col items-center\" data-kid=\"1-2-2-1-3-1-10\">\n                            <i class=\"icon-map-pin text-[26px] text-[var(--brand)] drop-shadow\" data-kid=\"1-2-2-1-3-1-10-1\">\n                            </i>\n                        </div>\n                        <div class=\"absolute left-[40%] top-[68%] flex flex-col items-center\" data-kid=\"1-2-2-1-3-1-11\">\n                            <i class=\"icon-map-pin text-[26px] text-[var(--brand)] drop-shadow\" data-kid=\"1-2-2-1-3-1-11-1\">\n                            </i>\n                        </div>\n                        <!-- location chip -->\n                        <div class=\"absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-lg bg-[var(--surface)]/95 px-2.5 py-1.5 text-[12px] font-semibold shadow-[0_1px_2px_rgba(15,37,49,.12)]\" data-kid=\"1-2-2-1-3-1-12\">\n                            <i class=\"icon-cross text-[13px] text-[var(--brand)]\" data-kid=\"1-2-2-1-3-1-12-1\">\n                            </i>\n                            Bandra West, Mumbai\n                        </div>\n                        <!-- zoom controls -->\n                        <div class=\"absolute right-3 top-3 flex flex-col overflow-hidden rounded-lg border border-[var(--rule)] bg-[var(--surface)] shadow-[0_1px_2px_rgba(15,37,49,.12)]\" data-kid=\"1-2-2-1-3-1-13\">\n                            <button class=\"flex h-8 w-8 items-center justify-center text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-2-1-3-1-13-1\">\n                                <i class=\"icon-plus text-[15px]\" data-kid=\"1-2-2-1-3-1-13-1-1\">\n                                </i>\n                            </button>\n                            <span class=\"h-px bg-[var(--rule)]\" data-kid=\"1-2-2-1-3-1-13-2\">\n                            </span>\n                            <button class=\"flex h-8 w-8 items-center justify-center text-[var(--ink-2)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-2-1-3-1-13-3\">\n                                <i class=\"icon-minus text-[15px]\" data-kid=\"1-2-2-1-3-1-13-3-1\">\n                                </i>\n                            </button>\n                        </div>\n                        <!-- attribution -->\n                        <div class=\"read absolute bottom-0 right-0 rounded-tl-lg bg-[var(--surface)]/85 px-2 py-1 text-[10.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-1-14\">\n                            © OpenStreetMap contributors\n                        </div>\n                    </div>\n                    <!-- FACILITY LIST -->\n                    <div class=\"flex flex-col\" data-kid=\"1-2-2-1-3-2\">\n                        <div class=\"mb-1 flex items-center justify-between px-1\" data-kid=\"1-2-2-1-3-2-1\">\n                            <p class=\"text-[13px] font-bold uppercase tracking-[0.08em] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-1-1\" data-name=\"results count label\">\n                                5 facilities\n                            </p>\n                            <p class=\"read text-[12px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-1-2\">\n                                Sorted by distance\n                            </p>\n                        </div>\n                        <ul class=\"divide-y divide-[var(--rule)]\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"facilities list\">\n                            <li class=\"flex items-start justify-between gap-4 py-4\" data-kid=\"1-2-2-1-3-2-2-1\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-2-1-3-2-2-1-1\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-3-2-2-1-1-1\">\n                                        <p class=\"truncate text-[15px] font-bold\" data-kid=\"1-2-2-1-3-2-2-1-1-1-1\">\n                                            Urgent Care Center\n                                        </p>\n                                        <span class=\"inline-flex items-center rounded bg-[var(--high-bg)] px-1.5 py-0.5 text-[11px] font-bold text-[var(--high)]\" data-kid=\"1-2-2-1-3-2-2-1-1-1-2\">\n                                            Emergency\n                                        </span>\n                                    </div>\n                                    <p class=\"read mt-1 text-[12.5px] leading-[1.45] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-1-1-2\">\n                                        Near St. Andrews Church, Bandra West\n                                    </p>\n                                    <div class=\"mt-2.5 flex items-center gap-2\" data-kid=\"1-2-2-1-3-2-2-1-1-3\">\n                                        <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg border border-[var(--rule)] px-3 text-[13px] font-semibold text-[var(--ink)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-2-1-3-2-2-1-1-3-1\" href=\"tel:+912226400000\">\n                                            <i class=\"icon-phone text-[14px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-1-1-3-1-1\">\n                                            </i>\n                                            Call\n                                        </a>\n                                        <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg px-2 text-[13px] font-bold text-[var(--brand)] hover:bg-[var(--brand-tint)]\" data-kid=\"1-2-2-1-3-2-2-1-1-3-2\" href=\"#\">\n                                            <i class=\"icon-navigation text-[14px]\" data-kid=\"1-2-2-1-3-2-2-1-1-3-2-1\">\n                                            </i>\n                                            Directions\n                                        </a>\n                                    </div>\n                                </div>\n                                <span class=\"tabnum shrink-0 text-[13px] font-bold text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-1-2\">\n                                    1.3 km\n                                </span>\n                            </li>\n                            <li class=\"flex items-start justify-between gap-4 py-4\" data-kid=\"1-2-2-1-3-2-2-2\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-2-1-3-2-2-2-1\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-3-2-2-2-1-1\">\n                                        <p class=\"truncate text-[15px] font-bold\" data-kid=\"1-2-2-1-3-2-2-2-1-1-1\">\n                                            City General Hospital\n                                        </p>\n                                        <span class=\"inline-flex items-center rounded bg-[var(--surface-alt)] px-1.5 py-0.5 text-[11px] font-bold text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-2-1-1-2\">\n                                            Hospital\n                                        </span>\n                                    </div>\n                                    <p class=\"read mt-1 text-[12.5px] leading-[1.45] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-2-1-2\">\n                                        Dr. D. N. Road, Bandra West\n                                    </p>\n                                    <div class=\"mt-2.5 flex items-center gap-2\" data-kid=\"1-2-2-1-3-2-2-2-1-3\">\n                                        <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg border border-[var(--rule)] px-3 text-[13px] font-semibold text-[var(--ink)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-2-1-3-2-2-2-1-3-1\" href=\"tel:+912226430000\">\n                                            <i class=\"icon-phone text-[14px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-2-1-3-1-1\">\n                                            </i>\n                                            Call\n                                        </a>\n                                        <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg px-2 text-[13px] font-bold text-[var(--brand)] hover:bg-[var(--brand-tint)]\" data-kid=\"1-2-2-1-3-2-2-2-1-3-2\" href=\"#\">\n                                            <i class=\"icon-navigation text-[14px]\" data-kid=\"1-2-2-1-3-2-2-2-1-3-2-1\">\n                                            </i>\n                                            Directions\n                                        </a>\n                                    </div>\n                                </div>\n                                <span class=\"tabnum shrink-0 text-[13px] font-bold text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-2-2\">\n                                    1.6 km\n                                </span>\n                            </li>\n                            <li class=\"flex items-start justify-between gap-4 py-4\" data-kid=\"1-2-2-1-3-2-2-3\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-2-1-3-2-2-3-1\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-3-2-2-3-1-1\">\n                                        <p class=\"truncate text-[15px] font-bold\" data-kid=\"1-2-2-1-3-2-2-3-1-1-1\">\n                                            Family Health Clinic\n                                        </p>\n                                        <span class=\"inline-flex items-center rounded bg-[var(--surface-alt)] px-1.5 py-0.5 text-[11px] font-bold text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-3-1-1-2\">\n                                            Clinic\n                                        </span>\n                                    </div>\n                                    <p class=\"read mt-1 text-[12.5px] leading-[1.45] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-3-1-2\">\n                                        Linking Road, Bandra West\n                                    </p>\n                                    <div class=\"mt-2.5 flex items-center gap-2\" data-kid=\"1-2-2-1-3-2-2-3-1-3\">\n                                        <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg border border-[var(--rule)] px-3 text-[13px] font-semibold text-[var(--ink)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-2-1-3-2-2-3-1-3-1\" href=\"tel:+912226520000\">\n                                            <i class=\"icon-phone text-[14px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-3-1-3-1-1\">\n                                            </i>\n                                            Call\n                                        </a>\n                                        <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg px-2 text-[13px] font-bold text-[var(--brand)] hover:bg-[var(--brand-tint)]\" data-kid=\"1-2-2-1-3-2-2-3-1-3-2\" href=\"#\">\n                                            <i class=\"icon-navigation text-[14px]\" data-kid=\"1-2-2-1-3-2-2-3-1-3-2-1\">\n                                            </i>\n                                            Directions\n                                        </a>\n                                    </div>\n                                </div>\n                                <span class=\"tabnum shrink-0 text-[13px] font-bold text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-3-2\">\n                                    1.8 km\n                                </span>\n                            </li>\n                            <li class=\"flex items-start justify-between gap-4 py-4\" data-kid=\"1-2-2-1-3-2-2-4\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-2-1-3-2-2-4-1\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-3-2-2-4-1-1\">\n                                        <p class=\"truncate text-[15px] font-bold\" data-kid=\"1-2-2-1-3-2-2-4-1-1-1\">\n                                            Community Care Clinic\n                                        </p>\n                                        <span class=\"inline-flex items-center rounded bg-[var(--surface-alt)] px-1.5 py-0.5 text-[11px] font-bold text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-4-1-1-2\">\n                                            Clinic\n                                        </span>\n                                    </div>\n                                    <p class=\"read mt-1 text-[12.5px] leading-[1.45] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-4-1-2\">\n                                        Hill Road, Bandra West\n                                    </p>\n                                    <div class=\"mt-2.5 flex items-center gap-2\" data-kid=\"1-2-2-1-3-2-2-4-1-3\">\n                                        <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg border border-[var(--rule)] px-3 text-[13px] font-semibold text-[var(--ink)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-2-1-3-2-2-4-1-3-1\" href=\"tel:+912226440000\">\n                                            <i class=\"icon-phone text-[14px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-4-1-3-1-1\">\n                                            </i>\n                                            Call\n                                        </a>\n                                        <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg px-2 text-[13px] font-bold text-[var(--brand)] hover:bg-[var(--brand-tint)]\" data-kid=\"1-2-2-1-3-2-2-4-1-3-2\" href=\"#\">\n                                            <i class=\"icon-navigation text-[14px]\" data-kid=\"1-2-2-1-3-2-2-4-1-3-2-1\">\n                                            </i>\n                                            Directions\n                                        </a>\n                                    </div>\n                                </div>\n                                <span class=\"tabnum shrink-0 text-[13px] font-bold text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-4-2\">\n                                    1.9 km\n                                </span>\n                            </li>\n                            <li class=\"flex items-start justify-between gap-4 py-4\" data-kid=\"1-2-2-1-3-2-2-5\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-2-1-3-2-2-5-1\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-3-2-2-5-1-1\">\n                                        <p class=\"truncate text-[15px] font-bold\" data-kid=\"1-2-2-1-3-2-2-5-1-1-1\">\n                                            Regional Medical Center\n                                        </p>\n                                        <span class=\"inline-flex items-center rounded bg-[var(--surface-alt)] px-1.5 py-0.5 text-[11px] font-bold text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-5-1-1-2\">\n                                            Hospital\n                                        </span>\n                                    </div>\n                                    <p class=\"read mt-1 text-[12.5px] leading-[1.45] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-5-1-2\">\n                                        S. V. Road, Bandra West\n                                    </p>\n                                    <div class=\"mt-2.5 flex items-center gap-2\" data-kid=\"1-2-2-1-3-2-2-5-1-3\">\n                                        <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg border border-[var(--rule)] px-3 text-[13px] font-semibold text-[var(--ink)] hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-2-1-3-2-2-5-1-3-1\" href=\"tel:+912226410000\">\n                                            <i class=\"icon-phone text-[14px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-5-1-3-1-1\">\n                                            </i>\n                                            Call\n                                        </a>\n                                        <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg px-2 text-[13px] font-bold text-[var(--brand)] hover:bg-[var(--brand-tint)]\" data-kid=\"1-2-2-1-3-2-2-5-1-3-2\" href=\"#\">\n                                            <i class=\"icon-navigation text-[14px]\" data-kid=\"1-2-2-1-3-2-2-5-1-3-2-1\">\n                                            </i>\n                                            Directions\n                                        </a>\n                                    </div>\n                                </div>\n                                <span class=\"tabnum shrink-0 text-[13px] font-bold text-[var(--ink-2)]\" data-kid=\"1-2-2-1-3-2-2-5-2\">\n                                    2.0 km\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n                <!-- privacy note -->\n                <div class=\"flex items-center gap-2 border-t border-[var(--rule)] px-6 py-4\" data-kid=\"1-2-2-1-4\">\n                    <i class=\"icon-shield-check text-[15px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-4-1\">\n                    </i>\n                    <p class=\"read text-[12.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-4-2\">\n                        Your location is read on this device and only used to find nearby care. MediAssist can't provide emergency services — call your local emergency number if symptoms are urgent.\n                    </p>\n                </div>\n            </section>\n        </main>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-18T11:51:28.594333+00:00",
      "modified": "2026-10-18T11:53:52.713790+00:00",
