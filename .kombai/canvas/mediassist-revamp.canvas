      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{\n  --canvas:#F3F7FA; --surface:#FFFFFF; --surface-alt:#EAF3F8;\n  --ink:#172B3A; --ink-2:#4B606D; --ink-3:#6C7F89; --rule:#CEDCE4;\n  --brand:#126B9A; --brand-strong:#0E567B; --brand-tint:#E7F1F7;\n  --low:#237B69; --low-bg:#E7F4EF;\n  --med:#956018; --med-bg:#FBF1DC;\n  --high:#AB502B; --high-bg:#FBE9DE;\n  --emg:#AE3446; --emg-bg:#FBE6E9;\n}\n.font-ui{font-family:'Manrope',system-ui,sans-serif;}\n.font-read{font-family:'Atkinson Hyperlegible',system-ui,sans-serif;}\n.tnum{font-variant-numeric:tabular-nums;}\n.lucide{stroke-width:1.75;}\n</style>\n<div class=\"font-read flex min-h-screen bg-[var(--canvas)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\" style=\"line-height:1.55\">\n    <!-- ============ SIDEBAR ============ -->\n    <aside class=\"sticky top-0 h-screen w-[264px] shrink-0 overflow-y-auto border-r border-[var(--rule)] bg-[var(--surface)]\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n        <div class=\"flex h-16 items-center gap-2.5 px-5\" data-kid=\"1-1-1\" data-name=\"brand logo header\">\n            <div class=\"grid h-9 w-9 place-items-center rounded-lg bg-[var(--brand-tint)]\" data-kid=\"1-1-1-1\" data-name=\"logo badge container\">\n                <i class=\"lucide icon-heart-pulse text-[18px] text-[var(--brand)]\" data-kid=\"1-1-1-1-1\" data-name=\"heart pulse logo icon\">\n                </i>\n            </div>\n            <div class=\"font-ui text-[17px] font-extrabold tracking-tight\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                <span class=\"text-[var(--ink)]\" data-kid=\"1-1-1-2-1\" data-name=\"brand name first word\">\n                    Medi\n                </span>\n                <span class=\"text-[var(--brand)]\" data-kid=\"1-1-1-2-2\" data-name=\"brand name highlighted word\">\n                    Assist\n                </span>\n                <span class=\"text-[var(--ink-3)] font-bold\" data-kid=\"1-1-1-2-3\" data-name=\"brand name AI suffix\">\n                    AI\n                </span>\n            </div>\n        </div>\n        <nav class=\"px-3 py-2\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n            <div class=\"px-2 pb-1.5 pt-2 font-ui text-[11px] font-bold uppercase tracking-[0.09em] text-[var(--ink-3)]\" data-kid=\"1-1-2-1\" data-name=\"section label care\">\n                Care\n            </div>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg bg-[var(--brand-tint)] px-3 py-2.5 font-ui text-[14.5px] font-semibold text-[var(--brand)]\" data-kid=\"1-1-2-2\" data-name=\"active overview nav link\" href=\"#\">\n                <i class=\"lucide icon-house text-[18px]\" data-kid=\"1-1-2-2-1\" data-name=\"house icon\">\n                </i>\n                Overview\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-3\" data-name=\"AI consultation nav link\" href=\"#\">\n                <i class=\"lucide icon-messages-square text-[18px]\" data-kid=\"1-1-2-3-1\" data-name=\"messages square icon\">\n                </i>\n                AI consultation\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-4\" data-name=\"voice consultation nav link\" href=\"#\">\n                <i class=\"lucide icon-mic text-[18px]\" data-kid=\"1-1-2-4-1\" data-name=\"microphone icon\">\n                </i>\n                Voice consultation\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-5\" data-name=\"image analysis nav link\" href=\"#\">\n                <i class=\"lucide icon-image text-[18px]\" data-kid=\"1-1-2-5-1\" data-name=\"image icon\">\n                </i>\n                Image analysis\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-6\" data-name=\"nearby care nav link\" href=\"#\">\n                <i class=\"lucide icon-map-pin text-[18px]\" data-kid=\"1-1-2-6-1\" data-name=\"map pin icon\">\n                </i>\n                Nearby care\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-7\" data-name=\"health check-in nav link\" href=\"#\">\n                <i class=\"lucide icon-shield-check text-[18px]\" data-kid=\"1-1-2-7-1\" data-name=\"shield check icon\">\n                </i>\n                Health check-in\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-8\" data-name=\"reminders nav link\" href=\"#\">\n                <i class=\"lucide icon-bell text-[18px]\" data-kid=\"1-1-2-8-1\" data-name=\"bell icon\">\n                </i>\n                Reminders\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-9\" data-name=\"reports nav link\" href=\"#\">\n                <i class=\"lucide icon-file-text text-[18px]\" data-kid=\"1-1-2-9-1\" data-name=\"file text icon\">\n                </i>\n                Reports\n            </a>\n            <div class=\"my-3 border-t border-[var(--rule)]\" data-kid=\"1-1-2-10\" data-name=\"nav divider\">\n            </div>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-11\" data-name=\"profile nav link\" href=\"#\">\n                <i class=\"lucide icon-user text-[18px]\" data-kid=\"1-1-2-11-1\" data-name=\"user icon\">\n                </i>\n                Profile\n            </a>\n            <a class=\"mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 font-ui text-[14.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-12\" data-name=\"settings nav link\" href=\"#\">\n                <i class=\"lucide icon-settings text-[18px]\" data-kid=\"1-1-2-12-1\" data-name=\"settings gear icon\">\n                </i>\n                Settings\n            </a>\n        </nav>\n        <div class=\"mt-2 px-3 pb-4\" data-kid=\"1-1-3\" data-name=\"sidebar bottom action area\">\n            <div class=\"rounded-xl bg-[var(--surface-alt)] p-4\" data-kid=\"1-1-3-1\" data-name=\"emergency finder card\">\n                <div class=\"flex items-center gap-2 font-ui text-[13.5px] font-bold text-[var(--ink)]\" data-kid=\"1-1-3-1-1\" data-name=\"emergency card title row\">\n                    <i class=\"lucide icon-map-pin text-[16px] text-[var(--brand)]\" data-kid=\"1-1-3-1-1-1\" data-name=\"map pin icon\">\n                    </i>\n                    Need care soon?\n                </div>\n                <p class=\"mt-1 text-[13px] leading-snug text-[var(--ink-2)]\" data-kid=\"1-1-3-1-2\" data-name=\"emergency card description text\">\n                    Find nearby hospitals and emergency rooms.\n                </p>\n                <a class=\"mt-2 inline-flex items-center gap-1 font-ui text-[13px] font-semibold text-[var(--brand)] hover:text-[var(--brand-strong)]\" data-kid=\"1-1-3-1-3\" data-name=\"find care link\" href=\"#\">\n                    Find care\n                    <i class=\"lucide icon-arrow-right text-[14px]\" data-kid=\"1-1-3-1-3-1\" data-name=\"right arrow icon\">\n                    </i>\n                </a>\n            </div>\n            <a class=\"mt-3 flex items-center gap-2.5 rounded-lg px-3 py-2 font-ui text-[13.5px] font-medium text-[var(--ink-2)] transition-colors hover:bg-[var(--emg-bg)] hover:text-[var(--emg)]\" data-kid=\"1-1-3-2\" data-name=\"sign out link\" href=\"#\">\n                <i class=\"lucide icon-log-out text-[17px]\" data-kid=\"1-1-3-2-1\" data-name=\"log out icon\">\n                </i>\n                Sign out\n            </a>\n        </div>\n    </aside>\n    <!-- ============ MAIN ============ -->\n    <div class=\"flex min-w-0 flex-1 flex-col\" data-kid=\"1-2\" data-name=\"main content column\">\n        <!-- Top header -->\n        <header class=\"sticky top-0 z-20 flex h-16 items-center justify-between border-b border-[var(--rule)] bg-[var(--surface)] px-6 lg:px-8\" data-kid=\"1-2-1\" data-name=\"top header bar\">\n            <h1 class=\"font-ui text-[19px] font-bold tracking-tight text-[var(--ink)]\" data-kid=\"1-2-1-1\" data-name=\"page title heading\">\n                Your health space\n            </h1>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2\" data-name=\"header actions container\">\n                <button aria-label=\"Switch to dark mode\" class=\"grid h-10 w-10 place-items-center rounded-lg border border-[var(--rule)] bg-[var(--surface)] text-[var(--ink-2)] transition-colors hover:bg-[var(--surface-alt)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-2-1\" data-name=\"dark mode toggle button\">\n                    <i class=\"lucide icon-moon text-[18px]\" data-kid=\"1-2-1-2-1-1\" data-name=\"moon icon\">\n                    </i>\n                </button>\n                <a class=\"flex items-center gap-2.5 rounded-lg py-1 pl-1 pr-3 transition-colors hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-1-2-2\" data-name=\"user profile chip\" href=\"#\">\n                    <span class=\"grid h-8 w-8 place-items-center rounded-full bg-[var(--brand)] font-ui text-[12.5px] font-bold text-white\" data-kid=\"1-2-1-2-2-1\" data-name=\"user avatar initials badge\">\n                        DU\n                    </span>\n                    <span class=\"font-ui text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-1-2-2-2\" data-name=\"user display name\">\n                        Demo User\n                    </span>\n                </a>\n            </div>\n        </header>\n        <!-- Content -->\n        <main class=\"mx-auto w-full max-w-[1200px] px-6 py-7 lg:px-8\" data-kid=\"1-2-2\" data-name=\"main scrollable content area\">\n            <!-- 1) Welcome band -->\n            <section class=\"rounded-2xl border border-[var(--rule)] bg-[var(--surface)] p-6 shadow-[0_1px_2px_rgba(15,37,49,.06)]\" data-kid=\"1-2-2-1\" data-name=\"welcome hero section\">\n                <div class=\"flex flex-wrap items-end justify-between gap-5\" data-kid=\"1-2-2-1-1\" data-name=\"hero content row\">\n                    <div class=\"min-w-[280px] flex-1\" data-kid=\"1-2-2-1-1-1\" data-name=\"hero text block\">\n                        <p class=\"font-ui text-[13.5px] font-semibold text-[var(--ink-2)]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"greeting subheading\">\n                            Welcome back, Demo\n                        </p>\n                        <h2 class=\"mt-1 font-ui text-[26px] font-extrabold leading-tight tracking-tight text-[var(--ink)]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"hero headline text\">\n                            How can we support your health today?\n                        </h2>\n                        <p class=\"mt-1.5 max-w-[52ch] text-[14.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-1-1-3\" data-name=\"hero description text\">\n                            Choose the way that feels easiest. MediAssist offers educational information and helps you decide when professional care is appropriate.\n                        </p>\n                        <div class=\"mt-4 flex flex-wrap items-center gap-3\" data-kid=\"1-2-2-1-1-1-4\" data-name=\"hero action buttons container\">\n                            <a class=\"inline-flex h-11 items-center gap-2 rounded-lg bg-[var(--brand)] px-5 font-ui text-[14.5px] font-semibold text-white transition-colors hover:bg-[var(--brand-strong)]\" data-kid=\"1-2-2-1-1-1-4-1\" data-name=\"primary new consultation button\" href=\"#\">\n                                <i class=\"lucide icon-plus text-[18px]\" data-kid=\"1-2-2-1-1-1-4-1-1\" data-name=\"plus icon\">\n                                </i>\n                                New consultation\n                            </a>\n                            <a class=\"inline-flex h-11 items-center gap-2 rounded-lg border border-[var(--rule)] bg-[var(--surface)] px-5 font-ui text-[14.5px] font-semibold text-[var(--ink)] transition-colors hover:bg-[var(--surface-alt)]\" data-kid=\"1-2-2-1-1-1-4-2\" data-name=\"secondary find nearby care button\" href=\"#\">\n                                <i class=\"lucide icon-map-pin text-[18px] text-[var(--ink-2)]\" data-kid=\"1-2-2-1-1-1-4-2-1\" data-name=\"map pin icon\">\n                                </i>\n                                Find nearby care\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-2.5 rounded-xl bg-[var(--surface-alt)] px-4 py-3\" data-kid=\"1-2-2-1-1-2\" data-name=\"disclaimer badge card\">\n                        <i class=\"lucide icon-shield-check text-[20px] text-[var(--brand)]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"shield check icon\">\n                        </i>\n                        <div class=\"text-[13px] leading-tight text-[var(--ink-2)]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"disclaimer text container\">\n                            <div class=\"font-ui font-bold text-[var(--ink)]\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"disclaimer title text\">\n                                Educational only\n                            </div>\n                            Never a substitute for a clinician.\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <!-- 2) Need immediate help notice -->\n            <section class=\"mt-4 flex items-start gap-3 rounded-xl bg-[var(--med-bg)] px-4 py-3\" data-kid=\"1-2-2-2\" data-name=\"emergency warning notification\">\n                <span class=\"mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-[var(--med)]\" data-kid=\"1-2-2-2-1\" data-name=\"warning dot indicator\">\n                </span>\n                <p class=\"text-[14px] leading-snug text-[var(--med)]\" data-kid=\"1-2-2-2-2\" data-name=\"warning message text\">\n                    <span class=\"font-ui font-bold\" data-kid=\"1-2-2-2-2-1\" data-name=\"warning bold prompt\">\n                        Need immediate help?\n                    </span>\n                    <span class=\"text-[#6E4A12]\" data-kid=\"1-2-2-2-2-2\" data-name=\"warning emergency details text\">\n                        For chest pain, trouble breathing, severe bleeding, stroke symptoms, loss of consciousness, or thoughts of self-harm, call emergency services now.\n                    </span>\n                </p>\n            </section>\n            <!-- 3) Your health at a glance -->\n            <section class=\"mt-6 rounded-2xl border border-[var(--rule)] bg-[var(--surface)] p-6 shadow-[0_1px_2px_rgba(15,37,49,.06)]\" data-kid=\"1-2-2-3\" data-name=\"health overview section\">\n                <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-3-1\" data-name=\"section header row\">\n                    <div data-kid=\"1-2-2-3-1-1\" data-name=\"section title block\">\n                        <h3 class=\"font-ui text-[17px] font-bold tracking-tight text-[var(--ink)]\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"section title heading\">\n                            Your health at a glance\n                        </h3>\n                        <p class=\"text-[13.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"section subtitle text\">\n                            Aggregated from your recent activity. Educational only.\n                        </p>\n                    </div>\n                    <i class=\"lucide icon-trending-up text-[20px] text-[var(--ink-3)]\" data-kid=\"1-2-2-3-1-2\" data-name=\"upward trend icon\">\n                    </i>\n                </div>\n                <!-- stat row (typographic, not inset cards) -->\n                <div class=\"mt-4 grid grid-cols-2 gap-y-5 border-y border-[var(--rule)] py-5 sm:grid-cols-4\" data-kid=\"1-2-2-3-2\" data-name=\"stats stat row\">\n                    <div class=\"sm:border-r sm:border-[var(--rule)] sm:pr-6\" data-kid=\"1-2-2-3-2-1\" data-name=\"consultations stat item\">\n                        <div class=\"font-ui tnum text-[30px] font-extrabold leading-none text-[var(--ink)]\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"consultations stat number\">\n                            3\n                        </div>\n                        <div class=\"mt-1.5 text-[13.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"consultations stat label\">\n                            Consultations\n                        </div>\n                    </div>\n                    <div class=\"sm:border-r sm:border-[var(--rule)] sm:px-6\" data-kid=\"1-2-2-3-2-2\" data-name=\"check-ins stat item\">\n                        <div class=\"font-ui tnum text-[30px] font-extrabold leading-none text-[var(--ink)]\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"check-ins stat number\">\n                            2\n                        </div>\n                        <div class=\"mt-1.5 text-[13.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"check-ins stat label\">\n                            Check-ins\n                        </div>\n                    </div>\n                    <div class=\"sm:border-r sm:border-[var(--rule)] sm:pl-6 sm:pr-6\" data-kid=\"1-2-2-3-2-3\" data-name=\"reports stat item\">\n                        <div class=\"font-ui tnum text-[30px] font-extrabold leading-none text-[var(--ink)]\" data-kid=\"1-2-2-3-2-3-1\" data-name=\"reports stat number\">\n                            1\n                        </div>\n                        <div class=\"mt-1.5 text-[13.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-3-2-3-2\" data-name=\"reports stat label\">\n                            Reports\n                        </div>\n                    </div>\n                    <div class=\"sm:pl-6\" data-kid=\"1-2-2-3-2-4\" data-name=\"images stat item\">\n                        <div class=\"font-ui tnum text-[30px] font-extrabold leading-none text-[var(--ink)]\" data-kid=\"1-2-2-3-2-4-1\" data-name=\"images stat number\">\n                            1\n                        </div>\n                        <div class=\"mt-1.5 text-[13.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-3-2-4-2\" data-name=\"images stat label\">\n                            Images\n                        </div>\n                    </div>\n                </div>\n                <!-- chart + urgency -->\n                <div class=\"mt-6 grid grid-cols-1 gap-8 lg:grid-cols-[1.5fr_1fr]\" data-kid=\"1-2-2-3-3\" data-name=\"chart and urgency grid\">\n                    <!-- Lifestyle risk chart -->\n                    <div data-kid=\"1-2-2-3-3-1\" data-name=\"lifestyle risk chart container\">\n                        <div class=\"flex items-baseline justify-between\" data-kid=\"1-2-2-3-3-1-1\" data-name=\"chart header row\">\n                            <h4 class=\"font-ui text-[14.5px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-3-3-1-1-1\" data-name=\"chart title text\">\n                                Lifestyle risk\n                            </h4>\n                            <span class=\"text-[12.5px] text-[var(--ink-3)]\" data-kid=\"1-2-2-3-3-1-1-2\" data-name=\"chart scale legend text\">\n                                0–100 · lower is better\n                            </span>\n                        </div>\n                        <div class=\"mt-2 rounded-xl border border-[var(--rule)] bg-[var(--canvas)] p-4\" data-kid=\"1-2-2-3-3-1-2\" data-name=\"chart card container\">\n                            <svg aria-label=\"Lifestyle risk trend over the last five check-ins, decreasing from 68 to 44\" class=\"h-auto w-full\" data-kid=\"1-2-2-3-3-1-2-1\" data-name=\"lifestyle risk bar chart svg\" role=\"img\" viewbox=\"0 0 520 210\">\n                                <!-- gridlines + y labels -->\n                                <g fill=\"#6C7F89\" font-family=\"Manrope, sans-serif\" font-size=\"11\">\n                                    <line stroke=\"#CEDCE4\" stroke-width=\"1\" x1=\"40\" x2=\"500\" y1=\"10\" y2=\"10\">\n                                    </line>\n                                    <text text-anchor=\"end\" x=\"32\" y=\"14\">\n                                        100\n                                    </text>\n                                    <line stroke=\"#E4EDF1\" stroke-width=\"1\" x1=\"40\" x2=\"500\" y1=\"52.5\" y2=\"52.5\">\n                                    </line>\n                                    <text text-anchor=\"end\" x=\"32\" y=\"56.5\">\n                                        75\n                                    </text>\n                                    <line stroke=\"#E4EDF1\" stroke-width=\"1\" x1=\"40\" x2=\"500\" y1=\"95\" y2=\"95\">\n                                    </line>\n                                    <text text-anchor=\"end\" x=\"32\" y=\"99\">\n                                        50\n                                    </text>\n                                    <line stroke=\"#E4EDF1\" stroke-width=\"1\" x1=\"40\" x2=\"500\" y1=\"137.5\" y2=\"137.5\">\n                                    </line>\n                                    <text text-anchor=\"end\" x=\"32\" y=\"141.5\">\n                                        25\n                                    </text>\n                                    <line stroke=\"#CEDCE4\" stroke-width=\"1\" x1=\"40\" x2=\"500\" y1=\"180\" y2=\"180\">\n                                    </line>\n                                    <text text-anchor=\"end\" x=\"32\" y=\"184\">\n                                        0\n                                    </text>\n                                </g>\n                                <!-- bars -->\n                                <g>\n                                    <rect fill=\"#126B9A\" height=\"115.6\" rx=\"4\" width=\"34\" x=\"69\" y=\"64.4\">\n                                    </rect>\n                                    <rect fill=\"#126B9A\" height=\"103.7\" rx=\"4\" width=\"34\" x=\"161\" y=\"76.3\">\n                                    </rect>\n                                    <rect fill=\"#126B9A\" height=\"93.5\" rx=\"4\" width=\"34\" x=\"253\" y=\"86.5\">\n                                    </rect>\n                                    <rect fill=\"#126B9A\" height=\"83.3\" rx=\"4\" width=\"34\" x=\"345\" y=\"96.7\">\n                                    </rect>\n                                    <rect fill=\"#956018\" height=\"74.8\" rx=\"4\" width=\"34\" x=\"437\" y=\"105.2\">\n                                    </rect>\n                                </g>\n                                <!-- value labels -->\n                                <g font-family=\"Manrope, sans-serif\" font-size=\"12\" font-weight=\"700\" text-anchor=\"middle\">\n                                    <text fill=\"#4B606D\" x=\"86\" y=\"57\">\n                                        68\n                                    </text>\n                                    <text fill=\"#4B606D\" x=\"178\" y=\"69\">\n                                        61\n                                    </text>\n                                    <text fill=\"#4B606D\" x=\"270\" y=\"79\">\n                                        55\n                                    </text>\n                                    <text fill=\"#4B606D\" x=\"362\" y=\"89\">\n                                        49\n                                    </text>\n                                    <text fill=\"#956018\" x=\"454\" y=\"98\">\n                                        44\n                                    </text>\n                                </g>\n                                <!-- x labels -->\n                                <g fill=\"#6C7F89\" font-family=\"Manrope, sans-serif\" font-size=\"11\" text-anchor=\"middle\">\n                                    <text x=\"86\" y=\"200\">\n                                        Sep 12\n                                    </text>\n                                    <text x=\"178\" y=\"200\">\n                                        Sep 26\n                                    </text>\n                                    <text x=\"270\" y=\"200\">\n                                        Oct 3\n                                    </text>\n                                    <text x=\"362\" y=\"200\">\n                                        Oct 10\n                                    </text>\n                                    <text x=\"454\" y=\"200\">\n                                        Oct 17\n                                    </text>\n                                </g>\n                            </svg>\n                            <p class=\"mt-2 flex items-center gap-1.5 text-[12.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-3-3-1-2-2\" data-name=\"chart insight text\">\n                                <span class=\"h-2 w-2 rounded-full bg-[var(--med)]\" data-kid=\"1-2-2-3-3-1-2-2-1\" data-name=\"insight colored dot\">\n                                </span>\n                                Latest check-in scored\n                                <span class=\"font-ui font-bold text-[var(--ink)]\" data-kid=\"1-2-2-3-3-1-2-2-2\" data-name=\"insight latest score number\">\n                                    44\n                                </span>\n                                — moderate risk, improving from 68.\n                            </p>\n                        </div>\n                    </div>\n                    <!-- Urgency mix (counted legend) -->\n                    <div data-kid=\"1-2-2-3-3-2\" data-name=\"urgency mix container\">\n                        <h4 class=\"font-ui text-[14.5px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-3-3-2-1\" data-name=\"urgency title text\">\n                            Recent conversation urgency\n                        </h4>\n                        <p class=\"text-[12.5px] text-[var(--ink-3)]\" data-kid=\"1-2-2-3-3-2-2\" data-name=\"urgency subtitle text\">\n                            Urgency flagged across 3 recent chats\n                        </p>\n                        <!-- honest stacked bar: total 3 -->\n                        <div class=\"mt-3 flex h-3 w-full overflow-hidden rounded-full bg-[var(--surface-alt)]\" data-kid=\"1-2-2-3-3-2-3\" data-name=\"urgency stacked bar\">\n                            <div class=\"h-full\" data-kid=\"1-2-2-3-3-2-3-1\" data-name=\"low segment of stacked bar\" style=\"width:66.6%;background:var(--low)\">\n                            </div>\n                            <div class=\"h-full\" data-kid=\"1-2-2-3-3-2-3-2\" data-name=\"medium segment of stacked bar\" style=\"width:33.3%;background:var(--med)\">\n                            </div>\n                        </div>\n                        <ul class=\"mt-4 space-y-2.5\" data-kid=\"1-2-2-3-3-2-4\" data-name=\"urgency legend list\">\n                            <li class=\"flex items-center justify-between text-[14px]\" data-kid=\"1-2-2-3-3-2-4-1\" data-name=\"low urgency legend row\">\n                                <span class=\"flex items-center gap-2.5 text-[var(--ink-2)]\" data-kid=\"1-2-2-3-3-2-4-1-1\" data-name=\"low urgency label container\">\n                                    <span class=\"h-2.5 w-2.5 rounded-full\" data-kid=\"1-2-2-3-3-2-4-1-1-1\" data-name=\"low urgency color dot\" style=\"background:var(--low)\">\n                                    </span>\n                                    Low\n                                </span>\n                                <span class=\"font-ui tnum font-bold text-[var(--ink)]\" data-kid=\"1-2-2-3-3-2-4-1-2\" data-name=\"low urgency count\">\n                                    2\n                                </span>\n                            </li>\n                            <li class=\"flex items-center justify-between text-[14px]\" data-kid=\"1-2-2-3-3-2-4-2\" data-name=\"medium urgency legend row\">\n                                <span class=\"flex items-center gap-2.5 text-[var(--ink-2)]\" data-kid=\"1-2-2-3-3-2-4-2-1\" data-name=\"medium urgency label container\">\n                                    <span class=\"h-2.5 w-2.5 rounded-full\" data-kid=\"1-2-2-3-3-2-4-2-1-1\" data-name=\"medium urgency color dot\" style=\"background:var(--med)\">\n                                    </span>\n                                    Medium\n                                </span>\n                                <span class=\