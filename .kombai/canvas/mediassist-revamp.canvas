                         </span>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </section>\n            <!-- Two-column body -->\n            <div class=\"mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[1.55fr_1fr]\" data-kid=\"1-2-2-4\" data-name=\"main content two column grid\">\n                <!-- LEFT COLUMN -->\n                <div class=\"space-y-6\" data-kid=\"1-2-2-4-1\" data-name=\"left content column\">\n                    <!-- Care tools -->\n                    <section class=\"rounded-2xl border border-[var(--rule)] bg-[var(--surface)] p-6\" data-kid=\"1-2-2-4-1-1\" data-name=\"care tools section\">\n                        <h3 class=\"font-ui text-[17px] font-bold tracking-tight text-[var(--ink)]\" data-kid=\"1-2-2-4-1-1-1\" data-name=\"care tools title\">\n                            Choose how you'd like to check in\n                        </h3>\n                        <p class=\"text-[13.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-4-1-1-2\" data-name=\"care tools subtitle\">\n                            Four ways to describe what's going on.\n                        </p>\n                        <div class=\"mt-2 divide-y divide-[var(--rule)]\" data-kid=\"1-2-2-4-1-1-3\" data-name=\"care tools list container\">\n                            <a class=\"group flex items-center gap-4 py-3.5\" data-kid=\"1-2-2-4-1-1-3-1\" data-name=\"text consultation tool link\" href=\"#\">\n                                <i class=\"lucide icon-messages-square shrink-0 text-[22px] text-[var(--ink-2)] transition-colors group-hover:text-[var(--brand)]\" data-kid=\"1-2-2-4-1-1-3-1-1\" data-name=\"messages square icon\">\n                                </i>\n                                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-4-1-1-3-1-2\" data-name=\"text consultation tool info\">\n                                    <div class=\"font-ui text-[15px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-4-1-1-3-1-2-1\" data-name=\"text consultation tool title\">\n                                        Start a text consultation\n                                    </div>\n                                    <div class=\"text-[13.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-4-1-1-3-1-2-2\" data-name=\"text consultation tool description\">\n                                        Describe symptoms and get cautious next-step guidance.\n                                    </div>\n                                </div>\n                                <i class=\"lucide icon-chevron-right shrink-0 text-[18px] text-[var(--ink-3)] transition-colors group-hover:text-[var(--brand)]\" data-kid=\"1-2-2-4-1-1-3-1-3\" data-name=\"right chevron icon\">\n                                </i>\n                            </a>\n                            <a class=\"group flex items-center gap-4 py-3.5\" data-kid=\"1-2-2-4-1-1-3-2\" data-name=\"voice consultation tool link\" href=\"#\">\n                                <i class=\"lucide icon-mic shrink-0 text-[22px] text-[var(--ink-2)] transition-colors group-hover:text-[var(--brand)]\" data-kid=\"1-2-2-4-1-1-3-2-1\" data-name=\"microphone icon\">\n                                </i>\n                                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-4-1-1-3-2-2\" data-name=\"voice consultation tool info\">\n                                    <div class=\"font-ui text-[15px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-4-1-1-3-2-2-1\" data-name=\"voice consultation tool title\">\n                                        Talk it through\n                                    </div>\n                                    <div class=\"text-[13.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-4-1-1-3-2-2-2\" data-name=\"voice consultation tool description\">\n                                        Record a voice consultation when typing is not ideal.\n                                    </div>\n                                </div>\n                                <i class=\"lucide icon-chevron-right shrink-0 text-[18px] text-[var(--ink-3)] transition-colors group-hover:text-[var(--brand)]\" data-kid=\"1-2-2-4-1-1-3-2-3\" data-name=\"right chevron icon\">\n                                </i>\n                            </a>\n                            <a class=\"group flex items-center gap-4 py-3.5\" data-kid=\"1-2-2-4-1-1-3-3\" data-name=\"image analysis tool link\" href=\"#\">\n                                <i class=\"lucide icon-image shrink-0 text-[22px] text-[var(--ink-2)] transition-colors group-hover:text-[var(--brand)]\" data-kid=\"1-2-2-4-1-1-3-3-1\" data-name=\"image icon\">\n                                </i>\n                                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-4-1-1-3-3-2\" data-name=\"image analysis tool info\">\n                                    <div class=\"font-ui text-[15px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-4-1-1-3-3-2-1\" data-name=\"image analysis tool title\">\n                                        Analyze an image\n                                    </div>\n                                    <div class=\"text-[13.5px] text-[var(--ink-2)]\" data-kid=\"1-2-2-4-1-1-3-3-2-2\" data-name=\"image analysis tool description\">\n                                        Share a visible skin or minor-wound concern safely.\n                                    </div>\n                                </div>\n                                <i class=\"lucide icon-chevron-right shrink-0 text-[18px] text-[var(--ink-3)] transition-colors group-hover:text-[var(--brand)]\" data-kid=\"1-2-2-4-1-1-3-3-3\" data-name=\"right chevron icon\">\n                                </i>\n                            </a>\n                            <a class=\"group flex items-center gap-4 py-3.5\" data-kid=\"1-2-2-4-1-1-3-4\" data-name=\"lifestyle check-in tool link\" href=\"#\">\n                                <i class=\"lucide icon