     <a class=\"inline-flex items-center gap-1 font-ui text-[13.5px] font-semibold text-[var(--brand)] hover:text-[var(--brand-strong)]\" data-kid=\"1-2-2-4-1-2-1-2\" data-name=\"new consultation link\" href=\"#\">\n                                New consultation\n                                <i class=\"lucide icon-plus text-[15px]\" data-kid=\"1-2-2-4-1-2-1-2-1\" data-name=\"plus icon\">\n                                </i>\n                            </a>\n                        </div>\n                        <div class=\"mt-1 divide-y divide-[var(--rule)]\" data-kid=\"1-2-2-4-1-2-2\" data-name=\"conversations list container\">\n                            <a class=\"group flex items-center gap-3 py-3\" data-kid=\"1-2-2-4-1-2-2-1\" data-name=\"chat conversation link\" href=\"#\">\n                                <span class=\"min-w-0 flex-1\" data-kid=\"1-2-2-4-1-2-2-1-1\" data-name=\"conversation details container\">\n                                    <span class=\"block truncate font-ui text-[14.5px] font-semibold text-[var(--ink)] group-hover:text-[var(--brand)]\" data-kid=\"1-2-2-4-1-2-2-1-1-1\" data-name=\"chat conversation title\">\n                                        Sore throat and fever for two days\n                                    </span>\n                                    <span class=\"text-[12.5px] text-[var(--ink-3)]\" data-kid=\"1-2-2-4-1-2-2-1-1-2\" data-name=\"chat conversation timestamp\">\n                                        Oct 17 · 4:55 PM\n                                    </span>\n                                </span>\n                                <span class=\"shrink-0 rounded-md bg-[var(--brand-tint)] px-2 py-0.5 font-ui text-[11.5px] font-bold text-[var(--brand)]\" data-kid=\"1-2-2-4-1-2-2-1-2\" data-name=\"chat type badge\">\n                                    chat\n                                </span>\n                            </a>\n                            <a class=\"group flex items-center gap-3